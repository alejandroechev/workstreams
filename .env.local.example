# Example .env.local. Copy to .env.local (gitignored) for local dev/release.
#
# Enables optional features that aren't shipped in the public CI release:
#   - Plan tile
#   - Code Walkthrough tile
#
# Set to 1 to enable, omit to disable.

VITE_ENABLE_OPTIONAL_FEATURES=1

# ── Sunset features ──
# Retired features are NOT covered by the toggle above, on purpose: that one
# means "show me the unfinished things", and a retirement folded into it would
# stay enabled on the very machine trying to stop using it. Each gets its own
# variable and defaults off.
#
# The task board was retired in favour of a per-workstream activity log. It
# still works and its data is untouched -- set this to 1 to bring it back.
#
# VITE_ENABLE_TASKS=1
